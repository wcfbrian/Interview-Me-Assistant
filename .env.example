# Required for runtime model and embedding requests through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Runtime model roles.
MAIN_MODEL=deepseek/deepseek-v4.1-flash
GUARD_MODEL=z-ai/glm-5.3-flash
EVALUATION_MODEL=typesafe/jev-1.13
EMBEDDING_MODEL=openai/text-embedding-3-small

# Public GitHub repositories are supported without a token. A token raises
# the GitHub API rate limit and is optional for this local prototype.
GITHUB_USERNAME=wcfbrian
GITHUB_TOKEN=

# Local source and generated artifact locations.
RESUME_PATH=data/resume.pdf
DATA_DIR=data
CHROMA_PERSIST_DIRECTORY=data/chroma

# Optional LangSmith tracing. Leave disabled unless you provide an API key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=interview-me

# Chainlit authentication. Set both values before deployment.
CHAINLIT_AUTH_USERNAME=interviewer
CHAINLIT_AUTH_PASSWORD=

# Runtime reliability and retrieval limits.
REQUEST_TIMEOUT_SECONDS=30
MAX_PROJECT_SEARCHES=2
MAX_README_FETCHES=2
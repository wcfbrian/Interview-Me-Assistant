# Required for runtime model and embedding requests through OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Runtime model roles.
MAIN_MODEL=deepseek/deepseek-v4.1-flash
GUARD_MODEL=z-ai/glm-5.3-flash
EVALUATION_MODEL=typesafe/jev-1.13
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Public GitHub repositories are supported without a token. A token raises
# the GitHub API rate limit and is optional for this local prototype.
GITHUB_USERNAME=wcfbrian
GITHUB_TOKEN=

# Local source and generated artifact locations.
RESUME_PATH=src/backend/data/resume.pdf
DATA_DIR=src/backend/data
CHROMA_PERSIST_DIRECTORY=src/backend/data/chroma

# Optional LangSmith tracing. Set these values to capture agent/tool/model runs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-me